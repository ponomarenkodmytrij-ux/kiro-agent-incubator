# Incubator Power — Configuration
# Copy this file to your workspace root as .env.incubator and fill in your details.

# Your full name (used in email signatures and PDF headers)
INCUBATOR_AUTHOR=John Doe

# Bank account number for payment request text
INCUBATOR_BANK_ACCOUNT=00 0000 0000 0000 0000 0000 0000

# Bank name
INCUBATOR_BANK_NAME=YourBank

# Transfer method description
INCUBATOR_TRANSFER_METHOD=express transfer

# Recipient email for draft creation
INCUBATOR_RECIPIENT_EMAIL=recipient@example.com

# Gmail label for organizing drafts (optional, leave empty to skip)
INCUBATOR_EMAIL_LABEL=

# Path to weasyprint binary
INCUBATOR_WEASYPRINT_PATH=/opt/homebrew/bin/weasyprint

# Output directory (use {workspace} as placeholder for current workspace path)
INCUBATOR_OUTPUT_DIR={workspace}/output
