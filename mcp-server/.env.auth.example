# Gmail credentials for draft creation
# 
# How to get an App Password:
# 1. Enable 2FA on your Google account: https://myaccount.google.com/security
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create a new app password (select "Mail" and your device)
# 4. Copy the 16-character password below (spaces optional)

GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
